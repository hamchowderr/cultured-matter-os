# Leave unset locally to use ./local.db
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL_HERE
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN_HERE

# Better Auth (Microsoft sign-in)
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE
BETTER_AUTH_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID_HERE
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET_HERE
# Comma-separated; only these accounts can sign in. Empty refuses everyone.
ALLOWED_EMAILS=you@example.com

# iPhone Shortcut capture (POST /api/capture). A long random key; rotate it by changing it here
# and in the Shortcut's Authorization header.
CAPTURE_TOKEN=YOUR_CAPTURE_TOKEN_HERE
# Vercel Blob (private store) for captured photos
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_READ_WRITE_TOKEN_HERE
