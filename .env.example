# Leave unset locally to use ./local.db
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL_HERE
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN_HERE

# Better Auth (Google sign-in, plus Gmail and Contacts for People)
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
# Comma-separated; only these accounts can sign in. Empty refuses everyone.
ALLOWED_EMAILS=you@example.com
# The owner, one of ALLOWED_EMAILS. Gmail, Contacts and the daily summary use her Google account,
# whoever else signs in. Unset locally: the most recent Google sign-in and the first account.
OWNER_EMAIL=you@example.com

# Newsletter (FluentCRM on her WordPress site). Unset or placeholder = "not connected yet".
FLUENTCRM_URL=https://YOUR_WORDPRESS_SITE_HERE
FLUENTCRM_USER=YOUR_WORDPRESS_USERNAME_HERE
FLUENTCRM_APP_PASSWORD=YOUR_APPLICATION_PASSWORD_HERE
FLUENTCRM_LIST_ID=YOUR_LIST_ID_HERE
# Shared secret FluentCRM's outgoing webhook sends in the X-Webhook-Secret header (16+ chars).
NEWSLETTER_WEBHOOK_SECRET=YOUR_NEWSLETTER_WEBHOOK_SECRET_HERE
# iPhone Shortcut capture (POST /api/capture). A long random key; rotate it by changing it here
# and in the Shortcut's Authorization header.
CAPTURE_TOKEN=YOUR_CAPTURE_TOKEN_HERE
# Vercel Blob (private store) for captured photos
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_READ_WRITE_TOKEN_HERE
# Daily summary email. Sent from her Gmail to herself by default. EMAIL_TRANSPORT=resend switches
# to Resend for owner testing, from EMAIL_FROM on a domain verified in Resend.
EMAIL_TRANSPORT=
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
EMAIL_FROM=Cultured Matter OS <no-reply@YOUR_VERIFIED_DOMAIN_HERE>
# Push notifications (web push). Generate once with `npx web-push generate-vapid-keys`.
# The public key is also given to the browser as NEXT_PUBLIC_VAPID_PUBLIC_KEY (same value; it is
# built into the client, so redeploy after changing it). VAPID_SUBJECT is the contact the push
# services see: a mailto: address or the app's https URL (defaults to BETTER_AUTH_URL).
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=

# The assistant (Mastra agent server, ./agent).
# Where the chat proxy forwards to. Leave it unset and the chat is hidden (no button, no
# dock, no /chat page; the chat's API routes answer 503), except under `next dev`, where it
# falls back to http://localhost:4111.
MASTRA_SERVER_URL=http://localhost:4111
# Shared with the agent server: the proxy signs each request with it (HS256, 32+ chars).
MASTRA_JWT_SECRET=YOUR_MASTRA_JWT_SECRET_HERE
# Shared with the agent server: the Bearer key it sends to /api/agent/actions.
# Unset closes that endpoint.
AGENT_SERVICE_TOKEN=YOUR_AGENT_SERVICE_TOKEN_HERE
